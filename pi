# -*- coding: utf-8 -*-

import serial
import threading
import requests
from flask import Flask, jsonify
import tkinter as tk

# ---------- CONFIG ----------
SERIAL_PORT = '/dev/ttyACM0'
BAUD = 115200
ESP32_IP = "xxx.xxx.x.xx"   # ← change to your ESP32 IP

# ---------- SERIAL ----------
try:
    ser = serial.Serial(SERIAL_PORT, BAUD, timeout=1)
    print("Serial connected")
except:
    print("ERROR: Cannot open serial port")
    ser = None

# ---------- GLOBAL DATA ----------
data = {
    "temp": "--",
    "heater": 0
}

# ---------- SERIAL READ ----------
def read_serial():
    while True:
        try:
            if ser:
                line = ser.readline().decode(errors='ignore').strip()

                if line:
                    print("UNO:", line)

                # Expect: TEMP:36.5
                if line.startswith("TEMP:"):
                    data["temp"] = line.split(":")[1]

        except:
            pass

# ---------- SEND TO UNO ----------
def send_to_uno(cmd):
    try:
        if ser:
            print("SEND UNO:", cmd)
            ser.write((cmd + "\n").encode())
    except:
        print("Serial error")

# ---------- ESP32 CONTROL ----------
def led_on(level):
    try:
        print("LED:", level)
        requests.get(f"http://{ESP32_IP}/?state=on&level={level}", timeout=2)
    except:
        print("ESP32 error")

def led_off():
    try:
        print("LED: off")
        requests.get(f"http://{ESP32_IP}/?state=off", timeout=2)
    except:
        print("ESP32 error")

# ==============================
# 🌐 FLASK WEB
# ==============================

app = Flask(__name__)

@app.route("/")
def home():
    return f"""
    <h1>Control Panel</h1>
    <p>Temperature: {data['temp']} C</p>

    <h3>Heater</h3>
    <a href="/heater/on">ON</a><br>
    <a href="/heater/off">OFF</a><br><br>

    <h3>LED</h3>
    <a href="/led/low">LOW</a><br>
    <a href="/led/medium">MEDIUM</a><br>
    <a href="/led/high">HIGH</a><br>
    <a href="/led/off">OFF</a>
    """

@app.route("/heater/<state>")
def heater(state):
    if state == "on":
        send_to_uno("HEATER_ON")
        data["heater"] = 1
    else:
        send_to_uno("HEATER_OFF")
        data["heater"] = 0
    return "OK"

@app.route("/led/<level>")
def led(level):
    if level == "off":
        led_off()
    else:
        led_on(level)
    return "OK"

@app.route("/data")
def get_data():
    return jsonify(data)

def run_flask():
    app.run(host='0.0.0.0', port=5000)

# ==============================
# 🖥 TKINTER GUI
# ==============================

def run_gui():
    root = tk.Tk()
    root.title("Control Panel")

    temp_label = tk.Label(root, text="Temp: -- C", font=("Arial", 16))
    temp_label.pack(pady=10)

    heater_label = tk.Label(root, text="Heater: OFF", font=("Arial", 14))
    heater_label.pack(pady=5)

    def update():
        temp_label.config(text=f"Temp: {data['temp']} C")

        if data["heater"] == 1:
            heater_label.config(text="Heater: ON")
        else:
            heater_label.config(text="Heater: OFF")

        root.after(1000, update)

    # Heater buttons
    tk.Button(root, text="Heater ON",
              command=lambda: send_to_uno("HEATER_ON"),
              width=20).pack(pady=5)

    tk.Button(root, text="Heater OFF",
              command=lambda: send_to_uno("HEATER_OFF"),
              width=20).pack(pady=5)

    # LED buttons
    tk.Button(root, text="LED LOW",
              command=lambda: led_on("low"),
              width=20).pack(pady=5)

    tk.Button(root, text="LED MEDIUM",
              command=lambda: led_on("medium"),
              width=20).pack(pady=5)

    tk.Button(root, text="LED HIGH",
              command=lambda: led_on("high"),
              width=20).pack(pady=5)

    tk.Button(root, text="LED OFF",
              command=led_off,
              width=20).pack(pady=5)

    update()
    root.mainloop()

# ==============================
# 🚀 MAIN
# ==============================

threading.Thread(target=read_serial, daemon=True).start()
threading.Thread(target=run_flask, daemon=True).start()

run_gui()
